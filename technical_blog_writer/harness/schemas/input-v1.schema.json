{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical blog intake preferences (never runtime approvals)",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "blog": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "audience": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "purpose": {"type": "string", "minLength": 1},
        "publication": {"enum": ["public", "internal"]},
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "required_coverage": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "series": {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": {"enum": ["single", "series"]},
            "part_number": {"type": "integer", "minimum": 1},
            "total_parts": {"type": "integer", "minimum": 1},
            "roadmap": {
              "type": "array", "items": {
                "type": "object", "additionalProperties": false, "required": ["part", "focus"],
                "properties": {"part": {"type": "integer", "minimum": 1}, "focus": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    },
    "draft": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "target_words": {"type": "integer", "minimum": 1},
        "versions": {"type": "integer", "enum": [2, 3]},
        "count_scope": {"type": "string", "minLength": 1},
        "technical_depth": {"type": "string", "minLength": 1},
        "tone": {"type": "string", "minLength": 1}
      }
    },
    "research": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "from_date": {"type": "string", "format": "date"},
        "cutoff_date": {"type": "string", "format": "date"},
        "questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_notes": {"type": "string"}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "mode"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "mode": {"enum": ["mcp", "manual"]},
          "links": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "scope_notes": {"type": "string"},
          "backend": {"type": "string", "minLength": 1},
          "scope_prefixes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "navigation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["none", "children", "links", "both"]},
        "max_depth": {"type": "integer", "minimum": 0},
        "max_items_per_source": {"type": "integer", "minimum": 1},
        "max_items_total": {"type": "integer", "minimum": 1},
        "max_links_per_item": {"type": "integer", "minimum": 1},
        "max_requests_per_backend": {"type": "integer", "minimum": 1},
        "max_requests_total": {"type": "integer", "minimum": 1},
        "max_elapsed_seconds": {"type": "integer", "minimum": 1},
        "min_interval_seconds": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0},
        "branch_low_value_limit": {"type": "integer", "minimum": 1},
        "global_low_value_limit": {"type": "integer", "minimum": 1}
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "store_confidential_locally": {"type": "boolean"},
        "publication_notes": {"type": "string"}
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "formats": {"type": "array", "minItems": 1, "items": {"enum": ["markdown", "html", "pdf", "google_doc"]}},
        "cloud_destinations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "title_preferences": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 3, "maximum": 7},
        "seed_title": {"type": "string", "minLength": 1},
        "style": {"type": "string"}
      }
    }
  }
}
